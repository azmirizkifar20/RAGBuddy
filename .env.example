QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ragbuddy_documents

EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY is only required when EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=

RAG_TOP_K=5

# Chat completion model used by the per-project chat endpoint (openai default: gpt-4o-mini, ollama default: llama3)
CHAT_MODEL=
# Max chat messages kept verbatim before older ones are auto-summarized
CHAT_CONTEXT_LIMIT=10

PROJECT_REGISTRY_PATH=./config/projects.json

# Chat's own base URL/provider/model/API key start out mirroring the embedding
# config above, until overridden from the dashboard's Settings page — this
# file just points at where that override gets persisted.
CHAT_SETTINGS_PATH=./config/chat-settings.json

# Writable state: sync history + documents uploaded through the dashboard
RAGBUDDY_DATA_DIR=./data

# Opt-in hardening for exposing the API beyond localhost — both unset by default,
# which keeps the existing no-auth/no-CORS local-trust-model behavior unchanged.
# Comma-separated list of origins allowed to call /api cross-origin from a browser (or "*" for any).
RAGBUDDY_ALLOWED_ORIGINS=
# Seeds the API key on first run only. Once generated/removed via the dashboard's Settings page
# ("API access" section), config/api-key.json becomes authoritative and this is ignored.
RAGBUDDY_API_KEY=
